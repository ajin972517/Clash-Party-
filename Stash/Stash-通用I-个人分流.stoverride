name: "通用I · 个人分流规则与策略组"
desc: |-
  Stash iOS 专用完整覆写。
  保留当前订阅的节点，替换订阅原有策略组与分流规则。
  由本地 Clash Party 个人规则转换；不含订阅地址、节点或凭据。

mode: rule

proxy-groups: #!replace
  - name: "🚀 通用I 节点选择"
    type: select
    include-all: true
    proxies:
      - "DIRECT"
  - name: "🌐 通用I Google服务"
    type: select
    include-all: true
    proxies:
